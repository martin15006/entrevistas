# Copia este archivo como .env y llena los valores.
# El .env nunca se sube a GitHub (está en .gitignore) y las llaves nunca se pegan en un chat.

# Servidor de desarrollo. 127.0.0.1 = solo este PC puede abrirlo.
PORT=3000
HOST=127.0.0.1
# Al publicar con HTTPS: NODE_ENV=production (cookies Secure y HSTS)
NODE_ENV=development
# Solo en la base de DESARROLLO: deja correr las pruebas en vivo (npm run test:vivo) y el script de
# sesiones de prueba, que crean y borran cuentas y datos. En la base de la clínica, se quita esta línea.
ENTORNO=desarrollo

# Supabase: Project Settings → API Keys (y el botón Connect para la URL)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Clave para firmar cookies (token anti-falsificación y actividad). Mínimo 32 caracteres al azar.
# Se genera con:  node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
CLAVE_FIRMA=
