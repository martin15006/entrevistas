<%- include('partes/arriba', { titulo: 'Subir censo', pagina: 'censo', estilos: ['censo'] }) %>
    <section id="subir-censo" class="censo" aria-labelledby="titulo-censo"
             data-tamano-maximo="<%= locals.tamanoMaximo %>"
             data-mensaje-grande="<%= locals.mensajes.grande %>"
             data-mensaje-sin-archivo="<%= locals.mensajes.sinArchivo %>"
             data-mensaje-conexion="<%= locals.mensajes.conexion %>">
      <h1 id="titulo-censo">Subir censo</h1>
      <p>Elige el censo consolidado en Excel (.xlsx o .xls, como lo descarga el sistema). Antes de guardar vas a ver un resumen.</p>

      <noscript><p class="aviso aviso--error">Esta pantalla necesita JavaScript activado.</p></noscript>

      <form id="form-censo" class="formulario" novalidate>
        <label class="campo">
          <span class="campo__nombre">Archivo del censo</span>
          <input type="file" id="archivo" name="archivo"
                 accept=".xlsx,.xls,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel" required>
        </label>
        <button type="submit" id="leer" class="boton boton--ancho">Leer censo</button>
      </form>

      <p id="aviso" class="aviso aviso--error" role="alert" hidden></p>

      <div id="resumen" class="resumen" hidden>
        <h2 class="resumen__titulo">Resumen</h2>
        <p id="resumen-linea" class="resumen__linea" role="status" aria-live="polite"></p>
        <ul id="resumen-avisos" class="resumen__avisos"></ul>

        <label id="elegir-fecha" class="campo" hidden>
          <span class="campo__nombre">No encontré la fecha del censo. Elígela:</span>
          <input type="date" id="fecha" value="<%= locals.hoy %>" max="<%= locals.hoy %>">
        </label>

        <div class="acciones">
          <button type="button" id="confirmar" class="boton">Confirmar</button>
          <button type="button" id="cancelar" class="boton boton--secundario">Cancelar</button>
        </div>
      </div>
    </section>
<%- include('partes/abajo', { scripts: ['/js/censo.js'] }) %>
